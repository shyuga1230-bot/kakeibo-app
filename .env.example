# ============================================================
# 環境変数の設定例
# このファイルを .env という名前でコピーして、値を書き換えてください。
#   コピー方法: cp .env.example .env
# ============================================================

# --- データベースの接続先 -----------------------------------
# ローカル(手元のPC)で動かす場合:
#   別のターミナルで `npm run db:up` を実行すると、ローカル用の
#   データベースが起動します。そのまま下の値で接続できます。
DATABASE_URL="postgres://postgres:postgres@localhost:51214/postgres?sslmode=disable&connection_limit=10&connect_timeout=0"

# 本番(Vercel + Neon など)の場合:
#   Neon などが発行する postgres:// で始まるURLをそのまま設定します。
#   (Vercel の Marketplace から Neon を追加すると自動で設定されます)
# DATABASE_URL="postgres://ユーザー:パスワード@ホスト名/データベース名?sslmode=require"

# --- ログイン用の全社共通パスワード --------------------------
# 全員がこのパスワードでログインします。必ず変更してください。
APP_PASSWORD="ここを全社共通のパスワードに変更してください"

# --- ログイン状態を保護するための秘密の文字列(推奨) --------
# 長いランダムな文字列を設定してください。
# 作り方の例(ターミナルで実行): openssl rand -base64 32
# 未設定の場合は APP_PASSWORD から自動生成されます
# (その場合、パスワードを変更すると全員ログインし直しになります)。
# SESSION_SECRET="ランダムな長い文字列"

# --- HTTPS を使わずに運用する場合のみ -------------------------
# 社内ネットワークで http:// のまま運用してログインできない場合は、
# 下の行の # を外してください。
# SESSION_COOKIE_SECURE="false"
