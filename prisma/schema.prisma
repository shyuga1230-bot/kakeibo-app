// データベースの設計図(Prisma スキーマ)
// 見積もり関連: quotes(見積もり) / quote_items(明細) / items(商品マスタ)
// 案件管理関連: projects(案件) / project_stages(工程の進捗) / project_logs(更新履歴)
// 書類関連: documents(納品書・請求書) / document_items(書類の明細) / company_settings(自社情報)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 見積もり(案件)1件
model Quote {
  id           Int         @id @default(autoincrement())
  // 日付は "YYYY-MM-DD" 形式の文字列で保存する(タイムゾーンのずれを防ぐため)
  quoteDate    String      @map("quote_date")
  customerName String?     @map("customer_name")
  memo         String?
  // 登録した人の名前(ログイン時に入力した名前)
  createdBy    String?     @map("created_by")
  // ごみ箱に入れた日時。NULL = 削除されていない。30日で完全削除される
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  items        QuoteItem[]
  documents    Document[]

  @@index([quoteDate])
  @@index([deletedAt])
  @@map("quotes")
}

// 納品書・請求書1枚。見積もりから作るときも内容をコピーして保存するため、
// あとから見積もりを変えても書類は変わらない(直したいときは書類側を編集する)。
model Document {
  id           Int            @id @default(autoincrement())
  // 種類: invoice(請求書) / delivery(納品書)
  type         String
  // 書類番号(例: "2026-0001")。種類ごとに年内の連番で自動採番、あとから変更もできる
  docNumber    String         @map("doc_number")
  // 日付は "YYYY-MM-DD" 形式の文字列(見積もりと同じ方針)
  issueDate    String         @map("issue_date")
  // お支払期限(請求書用・任意)
  dueDate      String?        @map("due_date")
  customerName String         @default("") @map("customer_name")
  // 宛名の敬称(御中・様)
  honorific    String         @default("御中")
  // 件名(工事名など)
  subject      String?
  // 備考(書類の下部に印字される)
  note         String?
  // 消費税率(%)
  taxRate      Int            @default(10) @map("tax_rate")
  // 元になった見積もり。見積もりが完全削除されても書類は残る(SetNull)
  quoteId      Int?           @map("quote_id")
  createdBy    String?        @map("created_by")
  // ごみ箱に入れた日時。NULL = 削除されていない。30日で完全削除される
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  quote        Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items        DocumentItem[]

  @@unique([type, docNumber])
  @@index([deletedAt])
  @@index([type, issueDate])
  @@index([quoteId])
  @@map("documents")
}

// 書類の明細1行(品名・数量・単位・単価・金額)
model DocumentItem {
  id         Int      @id @default(autoincrement())
  documentId Int      @map("document_id")
  // 表示順(0始まり)
  position   Int
  name       String
  // 数量(1.5 など小数もあるため実数・任意)
  quantity   Float?
  // 単位(式・m2 など・任意)
  unit       String?
  // 単価(円・整数・任意)。入れると金額が 数量×単価 で自動計算される
  unitPrice  Int?     @map("unit_price")
  // 金額(円・整数)
  amount     Int      @default(0)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, position])
  @@map("document_items")
}

// 自社情報(納品書・請求書に印字する会社名・住所・振込先など)。1行だけ使う。
model CompanySetting {
  id           Int      @id @default(1)
  name         String   @default("")
  postal       String?
  address      String?
  tel          String?
  fax          String?
  email        String?
  // 適格請求書発行事業者の登録番号(インボイス制度。T+13桁)
  invoiceRegNo String?  @map("invoice_reg_no")
  // 振込先(銀行名・支店・口座番号など。複数行で書ける)
  bankInfo     String?  @map("bank_info")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

// 商品マスタ(よく売る商品・サービスをあらかじめ登録しておく)。
// 見積もり登録画面でボタン一発で項目に追加できるようにするための一覧。
// 見積もりの明細(quote_items)は名前の文字列で保存するため、
// ここの名前を変えたり消したりしても過去の見積もりデータは変わらない。
model Item {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  // 標準金額(円・任意)。設定すると見積もり登録時に金額が自動で入る
  defaultAmount Int?     @map("default_amount")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("items")
}

// 案件(工事)1件。行=案件、列=工程 の管理表の「行」にあたる。
model Project {
  id          Int            @id @default(autoincrement())
  // 社名(顧客=施工会社)。あとから入れられるよう任意
  clientName  String?        @map("client_name")
  // 協力会社(Arkが業務を依頼する外注先)。任意
  partnerName String?        @map("partner_name")
  // 案件名(工事名)。必須
  projectName String         @map("project_name")
  // 備考(Excelの備考行に相当)
  memo        String?
  // ごみ箱に入れた日時。NULL = 削除されていない。30日で完全削除される
  deletedAt   DateTime?      @map("deleted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  stages      ProjectStage[]
  logs        ProjectLog[]

  @@index([clientName])
  @@index([deletedAt])
  @@map("projects")
}

// 案件×工程の進捗1マス。工程の種類(stageKey)はプログラム側で固定の13種
// (src/lib/project-stages.ts)。行が無い工程は「未着手」として扱うため、
// 最初に状態を変えたときに初めて行が作られる。
model ProjectStage {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  stageKey  String   @map("stage_key")
  // 状態: not_started(未着手) / in_progress(進行中) / done(完了) / not_applicable(対象外)
  status    String   @default("not_started")
  // 実施日・完了日は "YYYY-MM-DD" 形式の文字列(見積もりの日付と同じ方針)
  date      String?
  // 工程ごとのメモ(任意)
  memo      String?
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 同じ案件に同じ工程は1行だけ
  @@unique([projectId, stageKey])
  @@map("project_stages")
}

// 協力会社マスタ(振分け先の候補)。
// 案件の協力会社は名前の文字列で保存するため、
// ここの名前を変えたり消したりしても過去の案件データは変わらない。
model Partner {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("partners")
}

// 社員名簿(ログイン時に名前をプルダウンで選べるようにするための一覧)。
// 見積もりや更新履歴の名前は文字列で保存するため、
// ここの名前を変えたり消したりしても過去の記録は変わらない。
model Member {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("members")
}

// 案件の更新履歴(誰かが変更した内容を新しい順に表示するための記録)
model ProjectLog {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  // 変更内容の説明(例: 「起工測量」を「完了」に変更)
  action    String
  // 変更した人の名前(ログイン時に入力した名前)
  changedBy String?  @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_logs")
}

// 見積もりの明細(売れた項目)1行
model QuoteItem {
  id       Int    @id @default(autoincrement())
  quoteId  Int    @map("quote_id")
  itemName String @map("item_name")
  // 金額(円・整数)。不明な場合は空(NULL)でよい
  amount   Int?
  // 親の見積もりが削除されたら明細も一緒に削除される(onDelete: Cascade)
  quote    Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // 同じ見積もりの中に同じ項目名は登録できない
  @@unique([quoteId, itemName])
  @@index([itemName])
  @@map("quote_items")
}
